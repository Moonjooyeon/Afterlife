# Gemini 키는 서버에서만 씁니다. 브라우저 번들에는 절대 들어가지 않습니다.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE=https://generativelanguage.googleapis.com
# 여러 라우터를 순서대로 쓰고 싶을 때만 사용합니다. 있으면 GEMINI_API_KEY보다 우선합니다.
GEMINI_API_KEYS=
GEMINI_API_BASES=
GEMINI_API_KEY_FORMATS=
GEMINI_API_MODELS=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=8192
GENERATE_MAX_RETRY=3

APP_TITLE=[배포물 이름]
PORT=3000
HOST=127.0.0.1
RUNTIME_DIR=runtime
# 비우면 RUNTIME_DIR/afterlife.sqlite. Docker 운영은 /app/runtime/afterlife.sqlite로 둡니다.
DATABASE_PATH=

# 이용권. 끄면 무제한으로 돌아갑니다(개발 기본값).
TICKET_ENABLED=false
TICKET_FREE_CREDITS=0
TICKET_PASS_CREDITS=11
TICKET_TEST_PASS_ENABLED=false
TICKET_TEST_PASS_CREDITS=100

# ── 토스 로그인 ──────────────────────────────────────────────
# 끄면 지금까지처럼 기기(X-Device-Id) 단위로 동작합니다.
TOSS_LOGIN_ENABLED=false
TOSS_API_BASE=https://apps-in-toss-api.toss.im

# ▼ 직접 만들어 넣습니다: openssl rand -hex 32
#   비워두면 부팅할 때마다 새로 만들어져, 재시작하면 모두 다시 로그인해야 합니다.
SESSION_SECRET=
SESSION_TTL_DAYS=14

# ▼ 토스에서 받아옵니다: 앱인토스 콘솔에서 신청 → 인증 부서가 발급
#   받은 파일을 secrets/toss/ 아래 두고 경로만 적습니다. Git에는 올리지 않습니다.
TOSS_MTLS_CERT_PATH=./secrets/toss/cert.pem
TOSS_MTLS_KEY_PATH=./secrets/toss/key.pem
# ▼ 개인키에 비밀번호가 걸려 있을 때만 (같이 받아옵니다)
TOSS_MTLS_KEY_PASSWORD=

# ── 토스 인앱결제 ────────────────────────────────────────────
TOSS_IAP_ENABLED=false
# ▼ 토스 콘솔에 등록한 상품 가격과 맞춰야 합니다
TOSS_IAP_AMOUNT_KRW=0

# ── 프론트 빌드 변수 (VITE_ 로 시작하는 것만 번들에 들어갑니다) ──
# 프론트를 백엔드와 다른 도메인에 올릴 때만 채웁니다.
VITE_API_BASE_URL=
# ▼ 토스에서 받아옵니다: 콘솔에서 만든 IAP 상품의 SKU
#   비워두면 상품 목록에서 이용권 횟수가 이름에 든 상품을 자동으로 고릅니다.
VITE_TOSS_IAP_SKU=
